# Environment
# DEBUG_MODE activa logs SQL y otras funciones de debug (SOLO para desarrollo)
DEBUG_MODE=False

# Database Configuration
DATABASE_URL=sqlite:///./sigeca.db
# Para PostgreSQL (producción):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/sigeca_db

# Security
# ⚠️ IMPORTANTE: Genera una SECRET_KEY segura con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# La clave debe tener al menos 32 caracteres
SECRET_KEY=GENERAR_CLAVE_AQUI_CON_COMANDO_ARRIBA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Application
PROJECT_NAME=SIGECA
VERSION=1.0.0
API_V1_STR=/api/v1
